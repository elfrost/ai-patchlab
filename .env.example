# --- Database ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai-patchlab

# DSN pour MCP MySQL (utilisÃ© par Claude Code pour accÃ©der Ã  la DB directement)
# Format: mysql://user:password@host:port/database
# cPanel: mysql://cpaneluser_dbuser:password@sql.yourhost.com:3306/cpaneluser_dbname
MYSQL_DSN=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}

# --- Discord ---
DISCORD_WEBHOOK_URL=

# --- API Keys ---
# OPENROUTER_API_KEY=
# CNO_API_KEY=

# --- AI Runtime ---
# Optional model identifier used by ai-agent examples and Codex/OpenAI workflows
# LLM_MODEL=

# --- Application ---
LOG_LEVEL=DEBUG
ENV=development
